# eBilihan backend (BFF) environment variables.
# Copy to `.env` in this `server/` folder and fill in real values. NEVER commit `.env`,
# and NEVER move these values into the frontend's .env — they are secrets and the
# frontend bundle is extractable from the built APK/IPA. See CLAUDE.md > Security model.
#
# Where to get every value: sign in to the DICT API Developer Portal
# (https://platforms.e.gov.ph/dashboard), open each of the six API catalogs, and click
# "Generate credentials" on its Credentials tab.
#
# TWO THINGS THAT BITE IF YOU MISS THEM:
#   1. The gateway base URL is issued *with* the credential and is shown nowhere else —
#      copy it at the same moment you copy the keys.
#   2. Secret keys are shown ONCE, at creation. If you lose one you must revoke and
#      regenerate that credential, which invalidates the old value everywhere it is
#      already deployed (Render). Paste each straight into `.env` as you generate it.

PORT=4000
# Comma-separated list of origins allowed to call this server, or * for dev.
CORS_ORIGIN=*
# Signs eBilihan's own session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Public origins ------------------------------------------------------------------
# eGovPay and Face Liveness send the citizen (and their own servers) back to these, so
# both must be absolute HTTPS URLs reachable from the public internet. Not optional in
# production: a gateway cannot redirect anyone to localhost, and both APIs type these
# fields as `url`, so an app scheme like ebilihan:// is rejected.
#   APP_BASE_URL    the deployed web app       e.g. https://ebilihan.vercel.app
#   SERVER_BASE_URL this deployed backend      e.g. https://ebilihan-server.onrender.com
APP_BASE_URL=
SERVER_BASE_URL=

# --- Lending policy ------------------------------------------------------------------
# Loans at or above this amount (PHP) require the STORE OWNER to pass a Face Liveness
# check before the loan is recorded — separate from the borrower's own eVerify match, and
# enforced server-side. Typical sari-sari credit runs PHP 50-500, so 1000 marks a loan
# unusual enough to be worth confirming the owner is personally present.
# eBilihan's own policy — no eGov API imposes it. Optional; defaults to 1000.
LOAN_LIVENESS_THRESHOLD_PHP=1000

# --- eGov SSO ---------------------------------------------------------------------
# The base URL eGovPH itself calls to launch eBilihan is APP_BASE_URL + /egovph/sso —
# give that to eGovPH; it appends ?exchange_code=... when opening your service. There is
# no separate "authorize URL" to configure here (the old EGOVPH_AUTHORIZE_URL modelled a
# redirect flow that does not exist).
EGOVPH_BASE_URL=
# Safe to expose in a browser — the Login as eGov widget needs it, and the app fetches it
# from GET /auth/sso/widget-config rather than baking it into the bundle.
EGOVPH_PARTNER_CODE=
# Server-side only. Shown once at creation.
EGOVPH_PARTNER_SECRET=

# --- NationalID eVerify ----------------------------------------------------------
EVERIFY_BASE_URL=
EVERIFY_CLIENT_ID=
# Shown once at creation.
EVERIFY_CLIENT_SECRET=
# The Face Liveness Web SDK's public key — the portal's Variables panel labels this
# `public_api_key`. Public by design, served to the app via GET /verify/pubkey.
EVERIFY_PUBKEY=

# --- eMessage ---------------------------------------------------------------------
EMESSAGE_BASE_URL=
# Shown once at creation.
EMESSAGE_API_TOKEN=

# --- eGovPay ------------------------------------------------------------------------
EGOVPAY_BASE_URL=
# Shown once at creation. Also the HMAC key that signs every transaction `digest`, which
# is why eGovPay calls can never move to the client. Prefix with test_ while integrating
# so no live funds move.
EGOVPAY_API_TOKEN=
# Created separately under eGovPAY > Templates (not on the Credentials tab).
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=

# --- eReport --------------------------------------------------------------------------
EREPORT_BASE_URL=
# Shown once at creation.
EREPORT_ACCESS_CODE=

# --- Face Liveness (standalone REST product; separate from eVerify's embedded SDK) ----
FACE_LIVENESS_BASE_URL=
# Shown once at creation.
FACE_LIVENESS_API_KEY=
