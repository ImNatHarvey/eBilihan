# =============================================================================
#  eBilihan backend (BFF) — environment variables
# =============================================================================
#
#  Copy this file to `.env` in this same `server/` folder and fill in the values:
#
#      cd eBilihan-app/server
#      cp .env.example .env
#
#  Every eGov value below is EMPTY on purpose. Nothing here is a working default —
#  if a line is blank, you have to go and get the value. See
#  eBilihanReference/CREDENTIALS_GUIDE.md for how to get each one, in order.
#
#  NEVER commit `.env` (it is gitignored), and NEVER copy these values into the
#  frontend's .env — Vite inlines every VITE_ variable into the bundle that ships
#  inside the APK/IPA, where anyone can unzip and read it.
#
#  ---------------------------------------------------------------------------
#  LINES MARKED "SECRET · SHOWN ONCE" ARE SHOWN BY THE PORTAL EXACTLY ONCE, AT
#  CREATION. There are seven of them. Paste each into your .env the moment it
#  appears on screen. Losing one means revoking and regenerating that credential.
#  ---------------------------------------------------------------------------
#
# =============================================================================


# -----------------------------------------------------------------------------
#  Local server
# -----------------------------------------------------------------------------

# Port this backend listens on. The frontend's VITE_API_BASE_URL must match.
# Local value: 4000
PORT=4000

# Which origins may call this server. `*` is fine locally; tighten to your Vercel
# URL in production. Without it, browser requests from the app are blocked by CORS.
# Local value: *
CORS_ORIGIN=*

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET — but OURS, not the portal's. Generate it yourself:               │
# │      openssl rand -hex 32                                                 │
# │  Not from any eGov catalog, and not shown-once — you can regenerate it     │
# │  freely (doing so just signs everyone out).                                │
# └───────────────────────────────────────────────────────────────────────────┘
# Signs eBilihan's own session tokens. If blank, the server falls back to an
# insecure hardcoded dev constant — usable locally, never acceptable deployed.
JWT_SECRET=

# -----------------------------------------------------------------------------
#  Public origins
# -----------------------------------------------------------------------------
#  eGovPay and Face Liveness send real people (and their own servers) back to
#  these, so in production both must be absolute HTTPS URLs reachable from the
#  public internet. A custom scheme like ebilihan:// is rejected — both APIs type
#  these fields as `url`.
#
#  For local development the values below are correct as-is. Note that eGovPay's
#  callback and Face Liveness's redirect cannot actually REACH localhost from the
#  internet — to receive those for real, run a tunnel (ngrok / Cloudflare) and put
#  the tunnel URL in SERVER_BASE_URL. eGov SSO's own guide explicitly permits
#  "an HTTPS tunnel while developing".
# -----------------------------------------------------------------------------

# Where the citizen's browser lands after paying or after a liveness check.
# This is the FRONTEND. Local value: http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Where eGovPay's own server POSTs payment status callbacks. This is THIS BACKEND.
# Without it, payments are created but never settle.
# Local value: http://localhost:4000  (or your tunnel URL to receive real callbacks)
SERVER_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
#  Lending policy (eBilihan's own — no eGov API imposes it)
# -----------------------------------------------------------------------------

# Loans at or above this amount (PHP) require the STORE OWNER to pass a Face
# Liveness check before the loan is recorded — separate from the borrower's own
# eVerify match, and enforced server-side. Typical sari-sari credit runs PHP
# 50–500, so 1000 marks a loan unusual enough to re-confirm the owner is present.
# Optional. Omit and it defaults to 1000.
# Local value: 1000
LOAN_LIVENESS_THRESHOLD_PHP=1000


# =============================================================================
#  eGov SSO          Portal catalog: "eGov SSO"          Credentials tab
# =============================================================================
#  Generate this FIRST — nothing else in the app can be exercised without a
#  session. One active credential per developer: regenerating revokes the
#  previous one, so never regenerate mid-demo.
# =============================================================================

# The gateway base URL, issued together with the credential and shown NOWHERE
# else. Without it, all sign-in fails.
# Re-viewable on the Credentials tab.
EGOVPH_BASE_URL=

# Your partner identifier. The docs call this "safe to expose in a browser" — the
# Login as eGov widget needs it, and the app fetches it at runtime from
# GET /auth/sso/widget-config rather than baking it into the bundle.
# Without it, the sign-in widget won't render and check_access returns 0.
# Re-viewable on the Credentials tab.
EGOVPH_PARTNER_CODE=

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET · SHOWN ONCE AT CREATION                                          │
# └───────────────────────────────────────────────────────────────────────────┘
# Server-side only — the docs say plainly: "never expose it on the client side".
# Without it, POST /api/token returns 403 forbidden and sign-in is dead.
EGOVPH_PARTNER_SECRET=


# =============================================================================
#  NationalID eVerify   Portal catalog: "NationalID - eVerify"   Credentials tab
# =============================================================================

# Gateway base URL. Without it, borrower verification fails and no loan can be
# created. Re-viewable on the Credentials tab.
EVERIFY_BASE_URL=

# Your assigned API Client ID. Without it, POST /api/auth returns 403.
# Re-viewable on the Credentials tab.
EVERIFY_CLIENT_ID=

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET · SHOWN ONCE AT CREATION                                          │
# └───────────────────────────────────────────────────────────────────────────┘
# Your assigned API Client Secret. Without it, POST /api/auth returns 403 and the
# entire loan flow is blocked.
EVERIFY_CLIENT_SECRET=

# PUBLIC key for the client-side Face Liveness Web SDK
# (window.eKYC().start({ pubKey })). Not a secret — the app fetches it from
# GET /verify/pubkey. Without it, the SDK throws and the loan flow stops at the
# face check.
#
# NOTE: where this value comes from is NOT DOCUMENTED in the saved portal pages.
# It appears only as a portal test-runner variable named `public_api_key`, and
# the integration guide just says pubKey: "YOUR_PUBLIC_API_KEY". Check the portal
# — see CREDENTIALS_GUIDE.md and PORTAL_QUESTIONS.md Q6.
EVERIFY_PUBKEY=


# =============================================================================
#  eMessage             Portal catalog: "eMessage"             Credentials tab
# =============================================================================

# Gateway base URL. Without it, the loan confirmation OTP and the loan-agreement
# SMS both fail. (Sign-in no longer depends on this — eGovPH sends that OTP.)
# Re-viewable on the Credentials tab.
EMESSAGE_BASE_URL=

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET · SHOWN ONCE AT CREATION                                          │
# └───────────────────────────────────────────────────────────────────────────┘
# Sent as the X-EMESSAGE-Auth header. Without it, no SMS is delivered.
EMESSAGE_API_TOKEN=


# =============================================================================
#  eGovPay              Portal catalog: "eGovPAY"              Credentials tab
# =============================================================================

# Gateway base URL. Without it, checkout fails.
# Re-viewable on the Credentials tab.
EGOVPAY_BASE_URL=

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET · SHOWN ONCE AT CREATION                                          │
# └───────────────────────────────────────────────────────────────────────────┘
# The merchant token, sent as X-eGovPay-Token. It is ALSO the HMAC key that signs
# every transaction `digest`, which is why eGovPay can never be called from the
# app. PREFIX IT WITH test_ while integrating so no live funds move.
# Without it, checkout fails and digests can't be computed.
EGOVPAY_API_TOKEN=

# The settlement template used for bank settlements. Required on every payment —
# without it the server returns 503 before calling out.
#
# NOTE: created under eGovPAY > Templates, NOT the Credentials tab. The docs
# reference "(see Templates)" but never document that page. See
# PORTAL_QUESTIONS.md Q2(d). Not a secret.
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=


# =============================================================================
#  eReport              Portal catalog: "eReport"              Credentials tab
# =============================================================================

# Gateway base URL. Without it, filing a report AND every location dropdown
# (region/province/municipality/barangay) fails. Re-viewable on the Credentials tab.
EREPORT_BASE_URL=

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET · SHOWN ONCE AT CREATION                                          │
# └───────────────────────────────────────────────────────────────────────────┘
# Pre-issued access code, exchanged for a short-lived integration access_token.
# Without it, nothing in the Reports tab works.
#
# NOTE: whether the portal still calls this an `access_code` (vs a client
# id/secret pair) is NOT DOCUMENTED — its Credentials page shows only the empty
# state. See PORTAL_QUESTIONS.md Q6.
EREPORT_ACCESS_CODE=


# =============================================================================
#  Face Liveness        Portal catalog: "Face Liveness"        Credentials tab
# =============================================================================
#  A SEPARATE product from eVerify's embedded Face Liveness Web SDK above. Their
#  session tokens are different namespaces and are not interchangeable.
#  eBilihan uses this one for the store owner's high-value-loan check.
# =============================================================================

# Gateway base URL. Without it, loans at or above LOAN_LIVENESS_THRESHOLD_PHP
# cannot be issued. Re-viewable on the Credentials tab.
FACE_LIVENESS_BASE_URL=

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  SECRET · SHOWN ONCE AT CREATION                                          │
# └───────────────────────────────────────────────────────────────────────────┘
# Sent as the x-api-key header. Without it, high-value loans are blocked.
FACE_LIVENESS_API_KEY=
