# eBilihan backend (BFF) environment variables.
# Copy to `.env` in this `server/` folder and fill in real values. NEVER commit `.env`,
# and NEVER move these values into the frontend's .env — they are secrets and the
# frontend bundle is extractable from the built APK/IPA. See CLAUDE.md > Security model.
#
# Where to get every value: sign in to the eGOV APIs dashboard used to produce the
# screenshots in eBilihanReference/eGOV API/, then click "View API Credentials" on the
# dashboard home (see eBilihanReference/eGOV API/API Credentials.png). Base URLs are
# NOT shown in that dialog (it only lists keys/secrets) — copy each product's
# {{base_url}} from the "Variables" panel on its own API-documentation page.

PORT=4000
# Comma-separated list of origins allowed to call this server, or * for dev.
CORS_ORIGIN=*
# Signs eBilihan's own session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- eGov SSO (eGovPH) ---------------------------------------------------------
EGOVPH_BASE_URL=
EGOVPH_PARTNER_CODE=
EGOVPH_PARTNER_SECRET=
# Not captured in the reference screenshots (only the API-docs tab was reviewed, not
# the Integration tab) — the URL the app should open to log a user in via eGovPH SSO
# and receive an exchange_code back. Fill in from the eGovPH partner dashboard.
EGOVPH_AUTHORIZE_URL=

# --- NationalID eVerify ----------------------------------------------------------
EVERIFY_BASE_URL=
EVERIFY_CLIENT_ID=
EVERIFY_CLIENT_SECRET=
# Public key for the client-side Face Liveness Web SDK (window.eKYC().start({ pubKey })).
# Safe to expose to the mobile app (it's a *public* key) — served via GET /verify/pubkey.
EVERIFY_PUBKEY=

# --- eMessage ---------------------------------------------------------------------
EMESSAGE_BASE_URL=
EMESSAGE_API_TOKEN=

# --- eGovPay ------------------------------------------------------------------------
EGOVPAY_BASE_URL=
# Prefix with test_ while integrating so no live funds move (per eGovPay's own docs).
EGOVPAY_API_TOKEN=
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=

# --- eReport --------------------------------------------------------------------------
EREPORT_BASE_URL=
EREPORT_ACCESS_CODE=

# --- Face Liveness (standalone REST product; separate from eVerify's embedded SDK) ----
FACE_LIVENESS_BASE_URL=
FACE_LIVENESS_API_KEY=

# --- Demo sign-in number ----------------------------------------------------------
# E.164 mobile number standing in for a real eGovPH SSO identity (see CLAUDE.md >
# "Login AND registration currently use a hardcoded demo eGovPH identity"). Change
# this to test with a different number — MUST exactly match VITE_DEMO_MOBILE_E164 in
# the frontend's .env, or first-time login 404s ("No eBilihan store registered").
DEMO_MOBILE_E164=+639060585188
