# =============================================================================
#  eBilihan mobile app (Vite + Capacitor) — environment variables
# =============================================================================
#
#  Copy this file to `.env` in this same folder:
#
#      cd eBilihan-app
#      cp .env.example .env
#
#  ---------------------------------------------------------------------------
#  THERE ARE NO SECRETS IN THIS FILE, AND THERE MUST NEVER BE ONE.
#
#  Vite inlines every VITE_-prefixed variable into the built web bundle, and that
#  bundle ships inside the compiled APK/IPA — anyone can unzip the app and read
#  these strings. If you ever find a secret here, that is a bug: move it to
#  eBilihan-app/server/.env and expose it through a narrow backend endpoint.
#
#  Every real credential (partner_secret, client_secret, API tokens, access
#  codes) lives in server/.env. See server/.env.example.
#
#  This goes further than strictly required: even eGovPH's `partner_code` —
#  which its own documentation calls safe to expose in a browser — is NOT here.
#  The app fetches it at runtime from GET /auth/sso/widget-config, so rotating a
#  credential is a server-side change rather than an app rebuild and re-release.
#  ---------------------------------------------------------------------------
#
# =============================================================================


# -----------------------------------------------------------------------------
#  Required
# -----------------------------------------------------------------------------

# Base URL of the eBilihan backend (eBilihan-app/server). Must match the port the
# backend actually listens on (PORT in server/.env, default 4000). Without it,
# every request fails with "Can't reach the eBilihan server".
#
# Local value:  http://localhost:4000
# On a phone or emulator on the same network, localhost means the DEVICE, not
# your machine — use your machine's LAN IP instead, e.g. http://192.168.1.20:4000
# In production, point it at your deployed Render URL.
VITE_API_BASE_URL=http://localhost:4000


# -----------------------------------------------------------------------------
#  Optional — script URL overrides
# -----------------------------------------------------------------------------
#  Both have working defaults baked into the code, so leave these commented out
#  unless a URL changes. Both are public, documented script URLs — not credentials.
# -----------------------------------------------------------------------------

# eGovPH's "Login as eGov" widget. The integration guide asks integrators to pin
# the version explicitly, which is why the default is pinned at v1.0.0.
# Default: https://widgets.e.gov.ph/v1.0.0/egov-login.min.js
#VITE_EGOV_LOGIN_WIDGET_URL=

# eVerify's Face Liveness Web SDK, loaded by the borrower's device during loan
# verification.
# Default: https://hackathon-everify-face-liveness.e.gov.ph/js/everify-liveness-sdk.min.js
#VITE_EVERIFY_LIVENESS_SDK_URL=
