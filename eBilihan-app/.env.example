# eBilihan mobile app (Vite/Capacitor) environment variables.
# Copy to `.env` in this folder. Vite inlines every VITE_-prefixed variable into the
# built web bundle that ships inside the APK/IPA — anyone can unzip the app and read
# them. That's why this file only ever holds URLs and a public key, never a secret.
# All real credentials (partner_secret, client_secret, API tokens...) live in
# server/.env instead — see server/.env.example and CLAUDE.md > Security model.

# Base URL of the eBilihan backend (server/). Point this at your deployed backend in
# production; for local development with an emulator/device on the same network, use
# your machine's LAN IP instead of localhost (e.g. http://192.168.1.20:4000).
VITE_API_BASE_URL=http://localhost:4000

# Not captured in the reviewed reference screenshots (only the API-docs tab was seen,
# not eGovPH's Integration tab) — the URL to open for the user to log in via eGovPH SSO.
# Leave blank to fall back to pasting an exchange_code manually on the login screen.
VITE_EGOVPH_AUTHORIZE_URL=

# eVerify's Face Liveness Web SDK script. Defaults to the URL from
# eBilihanReference/eGOV API/eVerify/integration.png if left unset.
VITE_EVERIFY_LIVENESS_SDK_URL=https://hackathon-everify-face-liveness.e.gov.ph/js/everify-liveness-sdk.min.js

# Demo sign-in number (E.164, e.g. +639060585188) used in place of a real eGovPH SSO
# mobile number — see CLAUDE.md > "Login AND registration currently use a hardcoded
# demo eGovPH identity". Whoever is testing logs in with this number's OTP flow.
# MUST exactly match DEMO_MOBILE_E164 in server/.env, or first-time login 404s.
VITE_DEMO_MOBILE_E164=+639060585188
